<Project Sdk="Microsoft.NET.Sdk">

  <!-- Prüfprogramm für die Sandbox (nur Entwicklung, wird nicht ausgeliefert): startet pdfhost.exe im AppContainer, führt die
       Angriffsproben aus, rendert eine Seite als Bitmap und als EMF und misst die Zeiten. Aufruf: HostCheck.exe <Datei.pdf> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms><!-- nur für System.Drawing (Bilder speichern, EMF abspielen) -->
    <RootNamespace>PDFLight.HostCheck</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Protocol.cs" Link="Viewer\Protocol.cs" />
    <Compile Include="..\SandboxProcess.cs" Link="Viewer\SandboxProcess.cs" />
    <Compile Include="..\SandboxNative.cs" Link="Viewer\SandboxNative.cs" />
    <ProjectReference Include="..\Host\pdfhost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
