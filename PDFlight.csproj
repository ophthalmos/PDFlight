<Project>
  <!-- SDK-Importe explizit statt über das Sdk-Attribut, damit die Reference-Bereinigung
       unten NACH den SDK-/NuGet-Targets ausgewertet werden kann (ersetzt Directory.Build.targets) -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF><!-- nur für UIAutomationClient (Seitenzahl aus der Viewer-Toolbar lesen) -->
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.1</AssemblyVersion>
    <FileVersion>1.0.1</FileVersion>
    <Version>1.0.1</Version>
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId><!-- Builddatum für den Über-Dialog (TaskDlg.GetBuildDate) -->
    <Product>PDFlight</Product>
    <RootNamespace>PDFLight</RootNamespace><!-- Namespaces im Code bleiben PDFLight; nur der sichtbare Name ist PDFlight -->
    <Authors>Wilhelm Happe</Authors>
    <Description>Schlanker PDF-Betrachter mit Dateiverwaltung</Description>
    <NeutralLanguage>de</NeutralLanguage>
    <SatelliteResourceLanguages>de;en;fr;es</SatelliteResourceLanguages>
    <ApplicationIcon>PDFlight.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><!-- für die Quellgeneratoren LibraryImport/GeneratedComInterface -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="PDFsharp-GDI" Version="6.2.4" />
  </ItemGroup>

  <!-- UseWPF entfernt System.IO und System.Net.Http aus den impliziten Usings — hier wiederherstellen -->
  <ItemGroup>
    <Using Include="System.IO" />
    <None Include="pdffile.ico" CopyToOutputDirectory="PreserveNewest" /><!-- Explorer-Dateisymbol, s. ShellUtil.RegisterFileType -->
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Übersetzungs-Konsistenz (deutscher Text = resx-Schlüssel): meldet nach jedem Debug-Build
       fehlende und verwaiste Schlüssel als Warnungen (LNG001/LNG002), s. check-lng.ps1 -->
  <Target Name="CheckTranslations" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\check-lng.ps1&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="true" />
  </Target>

  <!-- WebView2 referenziert ungefragt auch seine WPF-Assembly; sie wird nicht benötigt und
       verursachte die MSB3277-Warnung (WindowsBase-Versionskonflikt). Das Entfernen muss nach
       den NuGet-Targets des Pakets stehen — ein Entfernen erst im Build ließe Visual Studio
       über einen nicht auflösbaren Referenzpfad klagen. -->
  <ItemGroup>
    <Reference Remove="@(Reference-&gt;WithMetadataValue('Filename', 'Microsoft.Web.WebView2.Wpf'))" />
  </ItemGroup>

</Project>
