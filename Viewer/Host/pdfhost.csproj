<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hilfsprogramm pdfhost.exe: PDFium in einem abgeschotteten Prozess (AppContainer, s. Viewer\SandboxProcess.cs). Bindet nur die
       native PDFium-DLL ein (bblanchon), keine Wrapper-Bibliothek – alle Aufrufe sind eigene LibraryImport-Deklarationen. Gebaut wird es
       vom Hauptprojekt (PDFlight.csproj), Version und Produktangaben kommen von dort. -->
  <PropertyGroup>
    <!-- kein Konsolenprogramm: das bräuchte beim Start einen Konsolen-Host (conhost.exe), und Kindprozesse sind verboten -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pdfhost</AssemblyName>
    <RootNamespace>PDFLight.Host</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Native AOT (dotnet publish): kein JIT – erst damit verträgt das Hilfsprogramm das Verbot, zur Laufzeit ausführbaren Code zu
         erzeugen (Arbitrary Code Guard, s. SandboxProcess); Control Flow Guard gegen umgebogene Sprungziele -->
    <PublishAot>true</PublishAot>
    <ControlFlowGuard>Guard</ControlFlowGuard>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- gemeinsamer Ausgabeordner mit HostCheck (Viewer\bin) -->
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Versionsangaben der EXE (Explorer, Task-Manager) -->
    <AssemblyTitle>PDFlight – PDF-Darstellung</AssemblyTitle>
    <Description>PDFlight – PDF-Darstellung</Description>
    <Product>PDFlight</Product>
    <Company>Wilhelm Happe</Company>
    <Authors>Wilhelm Happe</Authors>
    <Copyright>© 2026 W. Happe</Copyright>
    <Version Condition="'$(Version)' == ''">1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8086" />
    <Compile Include="..\Protocol.cs" Link="Protocol.cs" />
    <Using Include="PDFLight.Viewer" /><!-- Protocol -->
  </ItemGroup>

</Project>
