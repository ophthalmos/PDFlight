<Project>

  <!-- WebView2 referenziert ungefragt auch seine WPF-Assembly; sie wird nicht benötigt und
       verursachte die MSB3277-Warnung (WindowsBase-Versionskonflikt). Die Referenz wird hier
       schon zur Auswertungszeit entfernt (diese Datei wird nach den NuGet-Targets des Pakets
       ausgewertet) — ein Entfernen erst im Build ließe Visual Studio über einen nicht
       auflösbaren Referenzpfad klagen. -->
  <ItemGroup>
    <Reference Remove="@(Reference->WithMetadataValue('Filename', 'Microsoft.Web.WebView2.Wpf'))" />
  </ItemGroup>

</Project>
