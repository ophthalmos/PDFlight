<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <Version>0.1.0</Version>
    <Product>PDFlight</Product>
    <RootNamespace>PDFLight</RootNamespace><!-- Namespaces im Code bleiben PDFLight; nur der sichtbare Name ist PDFlight -->
    <Authors>Wilhelm Happe</Authors>
    <Description>Schlanker PDF-Betrachter mit Dateiverwaltung</Description>
    <NeutralLanguage>de</NeutralLanguage>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <ApplicationIcon>Resources\PDFlight.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><!-- für die Quellgeneratoren LibraryImport/GeneratedComInterface -->
  </PropertyGroup>

  <!-- WebView2 referenziert ungefragt auch seine WPF-Assembly; sie wird nicht benötigt
       und verursacht die MSB3277-Warnung (WindowsBase-Versionskonflikt). -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

</Project>
