<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hilfsprogramm pdfscript.exe: führt die JavaScript-Teile von PDF-Formularen aus, abgeschottet wie pdfhost (s. Viewer\SandboxProcess.cs),
       aber in einem eigenen Prozess ohne PDF-Daten: Es bekommt nur Skripttext und Feldwerte. Ein Absturz (Jint kann trotz Rekursionsgrenze
       überlaufen, etwa bei rekursivem toString) kostet deshalb keine Formulareingaben. Gebaut wird es vom Hauptprojekt (PDFlight.csproj). -->
  <PropertyGroup>
    <!-- kein Konsolenprogramm: das bräuchte beim Start einen Konsolen-Host (conhost.exe), und Kindprozesse sind verboten -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pdfscript</AssemblyName>
    <RootNamespace>PDFLight.Script</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Native AOT (dotnet publish): kein JIT, deshalb Arbitrary Code Guard möglich – wie pdfhost -->
    <PublishAot>true</PublishAot>
    <ControlFlowGuard>Guard</ControlFlowGuard>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Die Warnungen betreffen Jints Anbindung an .NET-Objekte (Reflection); die nutzt pdfscript nicht, es arbeitet nur mit ClrFunction und JsObject -->
    <NoWarn>$(NoWarn);IL2026;IL2104;IL3053</NoWarn>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- gemeinsamer Ausgabeordner mit pdfhost (Viewer\bin) -->
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Versionsangaben der EXE (Explorer, Task-Manager) -->
    <AssemblyTitle>PDFlight – Formular-Skripte</AssemblyTitle>
    <Description>PDFlight – Formular-Skripte</Description>
    <Product>PDFlight</Product>
    <Company>Wilhelm Happe</Company>
    <Authors>Wilhelm Happe</Authors>
    <Copyright>© 2026 W. Happe</Copyright>
    <Version Condition="'$(Version)' == ''">1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
    <Compile Include="..\Protocol.cs" Link="Protocol.cs" />
    <Compile Include="..\Host\CrashGuard.cs" Link="CrashGuard.cs" />
    <Compile Include="..\Host\Native.cs" Link="Native.cs" />
    <Using Include="PDFLight.Viewer" /><!-- Protocol -->
  </ItemGroup>

</Project>
